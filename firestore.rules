rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function ownsProperty(propertyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.get('ownerUid', '') == request.auth.uid;
    }

    function isValidProperty() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'city', 'ownerUid']) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.city is string && data.city.size() > 0 && data.city.size() <= 100;
    }

    function isValidRoom() {
      let data = request.resource.data;
      return data.keys().hasAll(['propertyId', 'roomName']) &&
        data.propertyId is string && data.roomName is string &&
        data.roomName.size() > 0 && data.roomName.size() <= 120;
    }

    function isValidEnquiry() {
      let data = request.resource.data;
      return data.keys().hasAll(['propertyId', 'guestName', 'guestPhone']) &&
        data.propertyId is string && data.guestName is string &&
        data.guestName.size() <= 100 && data.guestPhone is string &&
        data.guestPhone.size() <= 30 &&
        (!('message' in data) || (data.message is string && data.message.size() <= 2000));
    }

    function isValidBanner() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'imageUrl', 'position']) &&
        data.title is string && data.title.size() <= 200 &&
        data.position in ['home', 'search', 'property'];
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isValidProperty() && isSignedIn() &&
        (request.resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if isValidProperty() && isSignedIn() &&
        (resource.data.get('ownerUid', '') == request.auth.uid || isAdmin()) &&
        request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '') &&
        request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '');
      allow delete: if isSignedIn() &&
        (resource.data.get('ownerUid', '') == request.auth.uid || isAdmin());
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isValidRoom() && isSignedIn() &&
        ((request.resource.data.get('ownerUid', '') == request.auth.uid &&
          ownsProperty(request.resource.data.propertyId)) || isAdmin());
      allow update: if isValidRoom() && isSignedIn() &&
        (ownsProperty(resource.data.propertyId) || isAdmin()) &&
        request.resource.data.propertyId == resource.data.propertyId &&
        request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '');
      allow delete: if isSignedIn() &&
        (ownsProperty(resource.data.propertyId) || isAdmin());
    }

    match /enquiries/{enquiryId} {
      allow create: if isValidEnquiry();
      allow read, update, delete: if isAdmin() || ownsProperty(resource.data.propertyId);
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidBanner() &&
        (request.resource.data.get('advertiserUid', '') == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() &&
        (resource.data.get('advertiserUid', '') == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());
      allow update: if isUser(userId) &&
        (!('role' in request.resource.data) ||
         request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isUser(userId) || isAdmin();
    }

    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if isUser(userId) || isAdmin();
    }

    // Public visitors may record anonymous analytics, but only admins can read/manage it.
    match /visits/{visitId} {
      allow create: if request.resource.data.keys().hasAll(['propertyId', 'refId', 'timestamp']) &&
        request.resource.data.propertyId is string && request.resource.data.refId is string;
      allow read, update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['propertyId', 'refId', 'timestamp']) &&
        request.resource.data.propertyId is string && request.resource.data.refId is string &&
        (!('customerName' in request.resource.data) ||
         (request.resource.data.customerName is string && request.resource.data.customerName.size() <= 100));
      allow read, update, delete: if isAdmin();
    }
  }
}