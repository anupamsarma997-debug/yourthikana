rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // The platform has exactly one administrator: the founder's verified Google account.
    // Never grant admin privileges from editable Firestore profile fields or custom role claims.
    function isAdmin() {
      return signedIn() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', '') == 'anupamsarma997@gmail.com' &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com';
    }

    function ownsProperty(propertyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.get('ownerUid', '') == request.auth.uid;
    }

    function validPropertyCreate() {
      return request.resource.data.keys().hasAll([
        'title', 'city', 'ownerUid', 'ownerId', 'ownerName', 'ownerPhone',
        'ownerWhatsApp', 'description', 'propertyType', 'address', 'state',
        'latitude', 'longitude', 'checkInTime', 'checkOutTime', 'photos',
        'rating', 'reviewsCount', 'isVerified', 'isFeatured', 'status',
        'subscriptionPlan', 'subscriptionPrice', 'subscriptionExpiresAt', 'createdAt', 'duplicateKeys'
      ]) &&
      request.resource.data.title is string &&
      request.resource.data.city is string &&
      request.resource.data.ownerUid == request.auth.uid &&
      request.resource.data.ownerId == request.auth.uid &&
      request.resource.data.rating == 0 &&
      request.resource.data.reviewsCount == 0 &&
      request.resource.data.isVerified == false &&
      request.resource.data.isFeatured == false &&
      request.resource.data.status == 'pending' &&
      request.resource.data.subscriptionPlan == 'none' &&
      request.resource.data.subscriptionPrice == 0 &&
      request.resource.data.subscriptionExpiresAt == '' &&
      request.resource.data.duplicateKeys is list &&
      request.resource.data.duplicateKeys.size() == 1 &&
      existsAfter(/databases/$(database)/documents/property_duplicate_keys/$(request.resource.data.duplicateKeys[0])) &&
      getAfter(/databases/$(database)/documents/property_duplicate_keys/$(request.resource.data.duplicateKeys[0])).data.get('propertyId', '') == request.resource.data.id;
    }

    function validRoomCreate() {
      return request.resource.data.keys().hasAll(['propertyId', 'roomName']) &&
        request.resource.data.propertyId is string &&
        request.resource.data.roomName is string &&
        ownsProperty(request.resource.data.propertyId) &&
        request.resource.data.get('ownerUid', request.auth.uid) == request.auth.uid;
    }

    function validEnquiryCreate() {
      return request.resource.data.keys().hasAll([
        'propertyId', 'ownerUid', 'customerName', 'customerPhone',
        'propertyName', 'ownerId', 'ownerName', 'ownerWhatsApp',
        'checkInDate', 'checkOutDate', 'numberOfDays', 'adults',
        'children', 'totalGuests', 'selectedRoomId', 'selectedRoomName',
        'pricePerNight', 'calculatedTotal', 'formattedMessage'
      ]) &&
      request.resource.data.propertyId is string &&
      exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
      request.resource.data.ownerUid ==
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '') &&
      request.resource.data.customerName is string &&
      request.resource.data.customerName.size() <= 100 &&
      request.resource.data.customerPhone is string &&
      request.resource.data.customerPhone.size() <= 30 &&
      request.resource.data.formattedMessage is string &&
      request.resource.data.formattedMessage.size() <= 5000;
    }

    // SEARCH BOOST — WhatsApp proof review and independent payment confirmation.
    match /searchBoostApplications/{applicationId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'ownerUid', 'propertyId', 'propertyTitle', 'status', 'paymentStatus',
          'paymentUtr', 'proofSubmissionMethod', 'proofStatus', 'submittedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'propertyId', 'propertyTitle', 'status', 'paymentStatus',
          'paymentUtr', 'proofSubmissionMethod', 'proofStatus', 'submittedAt'
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.propertyId is string &&
        request.resource.data.propertyTitle is string &&
        request.resource.data.status == 'awaiting_payment' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.paymentUtr == '' &&
        request.resource.data.proofSubmissionMethod == 'whatsapp_share' &&
        request.resource.data.proofStatus == 'awaiting_payment' &&
        request.resource.data.submittedAt is timestamp &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '') == request.auth.uid &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('status', '') == 'active';

      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      // Owners can submit a real UTR after sharing proof. Only an unpaid draft or a
      // previously rejected application can be moved back into the admin review queue.
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        resource.data.status in ['awaiting_payment', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paymentStatus', 'paymentUtr', 'paymentSubmittedAt',
          'proofSubmissionMethod', 'proofStatus'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.paymentUtr is string &&
        request.resource.data.paymentUtr.matches('^[A-Za-z0-9-]{8,30}$') &&
        request.resource.data.paymentSubmittedAt is timestamp &&
        request.resource.data.proofSubmissionMethod == 'whatsapp_share' &&
        request.resource.data.proofStatus == 'awaiting_manual_review'
      );
      allow delete: if isAdmin();
    }

    // MONTHLY PLATFORM SUBSCRIPTION — ₹1,000 per active property per calendar month.
    match /subscriptionApplications/{applicationId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'ownerUid', 'propertyId', 'propertyTitle', 'amount', 'status',
          'paymentStatus', 'paymentUtr', 'proofSubmissionMethod', 'proofStatus', 'submittedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'propertyId', 'propertyTitle', 'amount', 'status',
          'paymentStatus', 'paymentUtr', 'proofSubmissionMethod', 'proofStatus', 'submittedAt'
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.propertyId is string &&
        request.resource.data.propertyTitle is string &&
        request.resource.data.amount == 1000 &&
        request.resource.data.status == 'awaiting_payment' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.paymentUtr == '' &&
        request.resource.data.proofSubmissionMethod == 'whatsapp_share' &&
        request.resource.data.proofStatus == 'awaiting_payment' &&
        request.resource.data.submittedAt is timestamp &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '') == request.auth.uid &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('status', '') == 'active' &&
        'subscriptionTrialEndsAtTimestamp' in get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.subscriptionTrialEndsAtTimestamp <= request.time;

      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        resource.data.status in ['awaiting_payment', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paymentStatus', 'paymentUtr', 'paymentSubmittedAt',
          'proofSubmissionMethod', 'proofStatus'
        ]) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.paymentUtr is string &&
        request.resource.data.paymentUtr.matches('^[A-Za-z0-9-]{8,30}$') &&
        request.resource.data.paymentSubmittedAt is timestamp &&
        request.resource.data.proofSubmissionMethod == 'whatsapp_share' &&
        request.resource.data.proofStatus == 'awaiting_manual_review'
      );
      allow delete: if isAdmin();
    }

    // Atomic one-listing-per-account reservation. The reservation is created
    // in the same transaction as the property and released only when that property is deleted.
    match /owner_listing_limits/{ownerUid} {
      allow read: if isSelf(ownerUid) || isAdmin();
      allow create: if isSelf(ownerUid) &&
        request.resource.data.ownerUid == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        getAfter(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '') == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() ||
        (isSelf(ownerUid) && !existsAfter(/databases/$(database)/documents/properties/$(resource.data.propertyId)));
    }

    // Global property fingerprint lock prevents the same property being reposted
    // from another account. Only a matching atomic property create can claim it.
    match /property_duplicate_keys/{duplicateKey} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        existsAfter(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        getAfter(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '') == request.auth.uid &&
        getAfter(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('duplicateKeys', []).hasAny([duplicateKey]);
      allow update: if false;
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.ownerUid == request.auth.uid &&
         !existsAfter(/databases/$(database)/documents/properties/$(resource.data.propertyId)));
    }

    match /properties/{propertyId} {
      // Public marketplace queries must constrain status to active.
      // Owners may separately query their own documents; admins may review all.
      allow read: if isAdmin() ||
        resource.data.get('status', '') == 'active' ||
        (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow create: if signedIn() && validPropertyCreate();
      allow update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.get('ownerUid', '') == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isVerified', 'isFeatured', 'verifiedUntil', 'featuredUntil',
            'rating', 'reviewsCount', 'subscriptionPlan', 'subscriptionPrice',
            'subscriptionStatus', 'subscriptionExpiresAt', 'subscriptionExpiryDate',
            'subscriptionTrialStartedAt', 'subscriptionTrialEndsAt',
            'ownerUid', 'ownerId', 'ownerEmail', 'status'
          ])
        );
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
    }

    match /rooms/{roomId} {
      // Rooms are readable only when their parent listing is public and active,
      // by that listing's owner, or by the verified platform-owner admin.
      allow read: if isAdmin() ||
        (exists(/databases/$(database)/documents/properties/$(resource.data.propertyId)) &&
         get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.get('status', '') == 'active') ||
        ownsProperty(resource.data.propertyId);
      allow create: if signedIn() && validRoomCreate();
      allow update: if isAdmin() ||
        (
          signedIn() &&
          ownsProperty(resource.data.propertyId) &&
          request.resource.data.propertyId == resource.data.propertyId &&
          request.resource.data.get('ownerUid', request.auth.uid) == request.auth.uid
        );
      allow delete: if isAdmin() ||
        ownsProperty(resource.data.propertyId) ||
        (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
    }

    match /enquiries/{enquiryId} {
      allow create: if validEnquiryCreate();
      allow read, delete: if isAdmin() ||
        (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow update: if isAdmin() ||
        (signedIn() &&
         resource.data.get('ownerUid', '') == request.auth.uid &&
         request.resource.data.ownerUid == resource.data.ownerUid);
    }

    match /visits/{visitId} {
      allow create: if request.resource.data.keys().hasAll(['propertyId', 'ownerUid', 'refId', 'timestamp', 'source']) &&
        request.resource.data.propertyId is string &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        request.resource.data.ownerUid ==
          get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '');
      allow read: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['propertyId', 'ownerUid', 'refId', 'timestamp', 'source']) &&
        request.resource.data.propertyId is string &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        request.resource.data.ownerUid ==
          get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '');
      allow read: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // BLUE TICK — owner applies in Firestore, proof is reviewed manually through WhatsApp.
    match /verificationApplications/{applicationId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'ownerUid', 'propertyId', 'propertyTitle', 'status', 'paymentStatus',
          'documentCount', 'documentPaths', 'proofSubmissionMethod', 'proofStatus', 'submittedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'propertyId', 'propertyTitle', 'status', 'paymentStatus',
          'documentCount', 'documentPaths', 'proofSubmissionMethod', 'proofStatus', 'submittedAt'
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.propertyId is string &&
        request.resource.data.propertyTitle is string &&
        request.resource.data.status == 'awaiting_payment' &&
        request.resource.data.paymentStatus == 'not_submitted' &&
        request.resource.data.documentCount is int &&
        request.resource.data.documentCount >= 0 &&
        request.resource.data.documentCount <= 5 &&
        request.resource.data.documentPaths is list &&
        request.resource.data.documentPaths.size() == 0 &&
        request.resource.data.proofSubmissionMethod == 'whatsapp_share' &&
        request.resource.data.proofStatus == 'awaiting_payment' &&
        request.resource.data.submittedAt is timestamp &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '') == request.auth.uid &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('status', '') == 'active';

      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        resource.data.status in ['awaiting_payment', 'pending', 'approved'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paymentUtr', 'paymentSubmittedAt', 'paymentStatus',
          'proofSubmissionMethod', 'proofStatus', 'documentsUploadedAt'
        ]) &&
        (
          (
            request.resource.data.status == 'pending' &&
            request.resource.data.paymentUtr is string &&
            request.resource.data.paymentUtr.matches('^[A-Za-z0-9-]{8,30}$') &&
            request.resource.data.paymentSubmittedAt is timestamp &&
            request.resource.data.paymentStatus == 'pending' &&
            request.resource.data.proofSubmissionMethod == 'whatsapp_share' &&
            request.resource.data.proofStatus == 'awaiting_manual_review'
          ) ||
          (
            request.resource.data.status == resource.data.status &&
            request.resource.data.proofStatus == 'documents_uploaded' &&
            request.resource.data.documentsUploadedAt is timestamp
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) &&
        request.resource.data.get('role', 'customer') in ['customer', 'owner'];
      allow update: if isAdmin() || (
        isSelf(userId) &&
        request.resource.data.get('role', resource.data.get('role', 'customer')) == resource.data.get('role', 'customer') &&
        request.resource.data.get('status', resource.data.get('status', 'active')) == resource.data.get('status', 'active') &&
        request.resource.data.get('createdAt', resource.data.get('createdAt', '')) == resource.data.get('createdAt', '') &&
        request.resource.data.get('googleUid', resource.data.get('googleUid', '')) == resource.data.get('googleUid', '')
      );
      allow delete: if isAdmin();
    }

    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if isSelf(userId) &&
        request.resource.data.keys().hasOnly(['id', 'name', 'username', 'role']) &&
        request.resource.data.get('role', 'customer') in ['customer', 'owner'];
      allow delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read, write: if isAdmin();
    }
  }
}
