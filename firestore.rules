rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
        )
      );
    }

    function ownsProperty(propertyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) &&
        get(/databases/$(database)/documents/properties/$(propertyId)).data.get('ownerUid', '') == request.auth.uid;
    }

    function validPropertyCreate() {
      return request.resource.data.keys().hasAll([
        'title', 'city', 'ownerUid', 'ownerId', 'ownerName', 'ownerPhone',
        'ownerWhatsApp', 'description', 'propertyType', 'address', 'state',
        'latitude', 'longitude', 'checkInTime', 'checkOutTime', 'photos',
        'rating', 'reviewsCount', 'isVerified', 'isFeatured', 'status',
        'subscriptionPlan', 'subscriptionPrice', 'subscriptionExpiresAt', 'createdAt'
      ]) &&
      request.resource.data.title is string &&
      request.resource.data.city is string &&
      request.resource.data.ownerUid == request.auth.uid &&
      request.resource.data.ownerId == request.auth.uid &&
      request.resource.data.rating == 0 &&
      request.resource.data.reviewsCount == 0 &&
      request.resource.data.isVerified == false &&
      request.resource.data.isFeatured == false &&
      request.resource.data.status in ['active', 'pending'] &&
      request.resource.data.subscriptionPlan == 'none' &&
      request.resource.data.subscriptionPrice == 0 &&
      request.resource.data.subscriptionExpiresAt == '';
    }

    function validRoomCreate() {
      return request.resource.data.keys().hasAll(['propertyId', 'roomName']) &&
        request.resource.data.propertyId is string &&
        request.resource.data.roomName is string &&
        ownsProperty(request.resource.data.propertyId) &&
        request.resource.data.get('ownerUid', request.auth.uid) == request.auth.uid;
    }

    function validEnquiryCreate() {
      return request.resource.data.keys().hasAll([
        'propertyId', 'ownerUid', 'customerName', 'customerPhone',
        'propertyName', 'ownerId', 'ownerName', 'ownerWhatsApp',
        'checkInDate', 'checkOutDate', 'numberOfDays', 'adults',
        'children', 'totalGuests', 'selectedRoomId', 'selectedRoomName',
        'pricePerNight', 'calculatedTotal', 'formattedMessage'
      ]) &&
      request.resource.data.propertyId is string &&
      exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
      request.resource.data.ownerUid ==
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '') &&
      request.resource.data.customerName is string &&
      request.resource.data.customerName.size() <= 100 &&
      request.resource.data.customerPhone is string &&
      request.resource.data.customerPhone.size() <= 30 &&
      request.resource.data.formattedMessage is string &&
      request.resource.data.formattedMessage.size() <= 5000;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if signedIn() && validPropertyCreate();
      allow update: if isAdmin() ||
        (
          signedIn() &&
          resource.data.get('ownerUid', '') == request.auth.uid &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.ownerId == resource.data.ownerId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isVerified', 'isFeatured', 'rating', 'reviewsCount',
            'subscriptionPlan', 'subscriptionPrice', 'subscriptionExpiresAt',
            'subscriptionExpiryDate', 'ownerUid', 'ownerId', 'ownerEmail'
          ])
        );
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if signedIn() && validRoomCreate();
      allow update: if isAdmin() ||
        (
          signedIn() &&
          ownsProperty(resource.data.propertyId) &&
          request.resource.data.propertyId == resource.data.propertyId &&
          request.resource.data.get('ownerUid', request.auth.uid) == request.auth.uid
        );
      allow delete: if isAdmin() || ownsProperty(resource.data.propertyId);
    }

    match /enquiries/{enquiryId} {
      allow create: if validEnquiryCreate();
      allow read, update, delete: if isAdmin() ||
        (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow update: if isAdmin() ||
        (signedIn() &&
         resource.data.get('ownerUid', '') == request.auth.uid &&
         request.resource.data.ownerUid == resource.data.ownerUid);
    }

    match /visits/{visitId} {
      allow create: if request.resource.data.keys().hasAll(['propertyId', 'ownerUid', 'refId', 'timestamp', 'source']) &&
        request.resource.data.propertyId is string &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        request.resource.data.ownerUid ==
          get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '');
      allow read: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['propertyId', 'ownerUid', 'refId', 'timestamp', 'source']) &&
        request.resource.data.propertyId is string &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        request.resource.data.ownerUid ==
          get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.get('ownerUid', '');
      allow read: if isAdmin() || (signedIn() && resource.data.get('ownerUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId) &&
        request.resource.data.get('role', 'customer') in ['customer', 'owner'];
      allow update: if isSelf(userId) &&
        request.resource.data.get('role', resource.data.get('role', 'customer')) == resource.data.get('role', 'customer') ||
        isAdmin();
      allow delete: if isAdmin();
    }

    match /public_profiles/{userId} {
      allow read: if true;
      allow create, update: if isSelf(userId) &&
        request.resource.data.keys().hasOnly(['id', 'name', 'username', 'role']) &&
        request.resource.data.get('role', 'customer') in ['customer', 'owner'];
      allow delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read, write: if isAdmin();
    }
  }
}