rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isAllowedImage() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/avif',
          'image/gif'
        ];
    }

    match /properties/{ownerUid}/{propertyId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(ownerUid) && isAllowedImage();
      allow delete: if isOwner(ownerUid);
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    match /verification-documents/{ownerUid}/{applicationId}/{fileName} {
      function applicationDoc() {
        return firestore.get(/databases/(default)/documents/verificationApplications/$(applicationId));
      }
      function isValidProof() {
        return request.resource != null &&
          request.resource.size > 0 &&
          request.resource.size <= 8 * 1024 * 1024 &&
          request.resource.contentType in [
            'image/jpeg', 'image/png', 'image/webp', 'application/pdf'
          ];
      }
      allow create: if isOwner(ownerUid) &&
        applicationDoc().data.ownerUid == ownerUid &&
        applicationDoc().data.status == 'pending' &&
        isValidProof();
      allow read: if isAdmin();
      allow delete: if isAdmin() ||
        (isOwner(ownerUid) && applicationDoc().data.ownerUid == ownerUid &&
          applicationDoc().data.status == 'pending');
      allow update: if false;
    }

    match /payment-proofs/{ownerUid}/{fileName} {
      allow create: if isOwner(ownerUid) &&
        request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow read: if isAdmin() || isOwner(ownerUid);
      allow delete: if isAdmin() || isOwner(ownerUid);
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}