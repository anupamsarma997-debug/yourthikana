rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', '') == 'anupamsarma997@gmail.com' &&
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com';
    }

    // Property photos: public read, but only the owning user (matched by UID in the
    // path) can upload/delete their own property's images.
    match /properties/{ownerUid}/{propertyId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(ownerUid)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(ownerUid) || isAdmin();
    }

    // Private Blue Tick evidence: only the verified platform admin can read.
    match /verification-documents/{ownerUid}/{applicationId}/{fileName} {
      function applicationDoc() {
        return firestore.get(/databases/(default)/documents/verificationApplications/$(applicationId));
      }
      function validProof() {
        return request.resource != null &&
          request.resource.size > 0 &&
          request.resource.size <= 8 * 1024 * 1024 &&
          request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
      }
      allow create: if isOwner(ownerUid) &&
        applicationDoc().data.ownerUid == ownerUid &&
        applicationDoc().data.status in ['awaiting_payment', 'pending'] &&
        validProof();
      allow read: if isAdmin();
      allow delete: if isAdmin() ||
        (isOwner(ownerUid) && applicationDoc().data.ownerUid == ownerUid &&
          applicationDoc().data.status in ['awaiting_payment', 'pending']);
      allow update: if false;
    }

    // Payment screenshots are shared directly from the owner's device to WhatsApp.
    // They are intentionally not uploaded to Firebase Storage.

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
